# Enforce LF line endings for shell scripts, Python, Compose and config files on Windows
* text=auto
*.dockerignore text eol=lf
**/.dockerignore text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.conf text eol=lf
.env text eol=lf
.env.example text eol=lf

# Container images and geodata are binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.mp4 binary
*.mbtiles binary
*.ico binary
