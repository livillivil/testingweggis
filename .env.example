# ============================================================
# KMC-GIS-SERVER Runtime Environment Template (.env.example)
# "Build Once, Run Anywhere" + Docker Swarm Secrets Golden Practice
#
# GOLDEN PRACTICE RULE:
# - Never store plaintext passwords or JWT keys in `.env` or `environment:`
#   in production.
# - In Docker Swarm (`docker-compose.swarm.yml`), all sensitive secrets are
#   mounted as read-only files at `/run/secrets/<secret_name>` (tmpfs, mode
#   0400) and referenced via `*_FILE` variables with ENFORCE_SWARM_SECRETS=true.
# - For local `docker compose up --build`, ENFORCE_SWARM_SECRETS defaults to
#   false so cold-start works cleanly even without `./secrets/*.txt`.
# ============================================================

# Image Tag, BuildKit & Runtime Environment
COMPOSE_BAKE=false
DOCKER_BUILDKIT=1
IMAGE_TAG=latest
APP_NAME=KMC-GIS-SERVER
APP_ENV=production
ENFORCE_SWARM_SECRETS=false
SECRET_VERSION=v1

# Golden Port Rule — ONLY nginx publishes host ports.
# Canonical ingress: http://localhost:${HOST_PORT}
# HTTPS (${HOST_SSL_PORT}) is enabled by the opt-in TLS overlay:
#   docker compose -f docker-compose.yml -f docker-compose.tls.yml up -d
HOST_PORT=80
HOST_SSL_PORT=443

# Debug-only loopback ports (docker-compose.dev.yml, bound to 127.0.0.1)
FRONTEND_PORT=3000
GEOPORTAL_PORT=3001
BACKEND_PORT=8000
POSTGRES_HOST_PORT=5432

# Auth.js / NextAuth Proxy Trust
AUTH_TRUST_HOST=true

# Client Runtime Endpoints (injected at container start by docker-entrypoint.sh)
API_URL=/api
TILE_URL=/tiles
GEOPORTAL_URL=/geoportal

# Internal Service Discovery URLs (Container-to-Container DNS)
BACKEND_INTERNAL_URL=http://backend:8000
TILESERVER_INTERNAL_URL=http://tileserver:8080
GEOPORTAL_INTERNAL_URL=http://geoportal:3000
MARTIN_INTERNAL_URL=http://martin:3000
GEOSERVER_INTERNAL_URL=http://geoserver:8080/geoserver

# PostgreSQL 16 + PostGIS 3.4 + PgBouncer Non-Secret Parameters + Swarm Secret Path
POSTGRES_DB=kmc_gis
POSTGRES_USER=kmc_user
POSTGRES_HOST=pgbouncer
POSTGRES_PORT=5432
POSTGRES_PASSWORD_FILE=/run/secrets/kmc_postgres_password

# Redis 7.4 Non-Secret Parameters + Swarm Secret Path
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD_FILE=/run/secrets/kmc_redis_password

# FastAPI JWT & SuperAdmin Non-Secret Parameters + Swarm Secret Paths
SECRET_KEY_FILE=/run/secrets/kmc_jwt_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7
ADMIN_USERNAME=KmcSuperAdmin
ADMIN_EMAIL=admin@kmc.gov.np
ADMIN_PASSWORD_FILE=/run/secrets/kmc_admin_password
ADMIN_FULL_NAME=""
MASTER_ADMIN_USERNAME=KmcMasterAdmin
MASTER_ADMIN_EMAIL=master@kmc.gov.np
MASTER_ADMIN_PASSWORD_FILE=/run/secrets/kmc_master_admin_password
MASTER_ADMIN_FULL_NAME=""

# GeoServer OGC Non-Secret Parameters + Swarm Secret Path
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD_FILE=/run/secrets/kmc_geoserver_admin_password

# Upload & API Hardening
MAX_UPLOAD_SIZE_MB=1048576
# Keep API docs disabled in production.
ENABLE_API_DOCS=false
# Empty = same-origin only (Next.js proxies /api). Never combine "*" with credentials.
CORS_ALLOW_ORIGINS=

# 5-Layer Nepal Sovereign Geo-Gate (MaxMind GeoLite2)
# enforce = deny unverifiable clients, monitor = annotate only, off = disabled.
# GeoLite2-Country.mmdb / GeoLite2-ASN.mmdb go into ./data/geoip (read-only mount).
GEO_GATE_MODE=monitor
GEOIP_COUNTRY_DB=/app/geoip/GeoLite2-Country.mmdb
GEOIP_ASN_DB=/app/geoip/GeoLite2-ASN.mmdb
GEOIP_BLOCKED_ASNS=

# Optional one-time password for freshly seeded staff accounts. When empty, each
# seeded account receives an unknown random password and an admin must reset it.
# SEED_USER_PASSWORD_FILE=/run/secrets/kmc_seed_user_password
