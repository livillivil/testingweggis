# ============================================================
# KMC-GIS-SERVER — Repository Ignore Rules
#
# Doctrine: secrets, environment files and runtime geodata NEVER
# enter version control. They are provisioned on the host and mounted
# into containers (see README "Quick Start").
# ============================================================

# ---- Secrets & environment (never commit) ----
.env
.env.*
!.env.example
secrets/*
!secrets/README.md

# ---- Local recovery archives & compressed packages ----
_archive/
*.zip
*.tar
*.gz
*.tgz
*.bz2
*.xz
*.rar
*.7z
*.bak
*.backup
*.dump

# ---- Large video recordings & media captures ----
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.flv
*.wmv

# ---- Presentations, pitch decks & office locks ----
*.pptx
*.ppt
*.key
*.odp
docs/presentation/
.qoder-office-pptx-locks/
~$*

# ---- Node.js / Next.js ----
node_modules/
.next/
out/
build/
dist/
coverage/
*.tsbuildinfo
.eslintcache
package-lock.json
npm-debug.log*
yarn-debug.log*
yarn-error.log*
bun-debug.log*

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/

# ---- Runtime geodata (host-bound persistence, not source) ----
# data/postgres        -> named-volume style PostGIS data directory
# data/tileserver      -> uploaded UAV orthophoto .mbtiles + generated config.json/state store
# data/uploads/layers  -> uploaded vector GeoJSON layers
data/postgres/
data/tileserver/**
!data/tileserver/temp/
data/tileserver/temp/**
!data/tileserver/temp/.gitkeep
!data/tileserver/temp/README.md
data/uploads/**
!data/uploads/offline_bundles/
data/uploads/offline_bundles/**
!data/uploads/offline_bundles/.gitkeep
!data/uploads/offline_bundles/README.md
data/geoserver/**
!data/geoserver/.gitkeep
!data/geoserver/README.md
data/geoip/**
!data/geoip/.gitkeep
!data/geoip/README.md

# ---- Uploaded geodata (belt-and-braces: never commit binaries) ----
*.mbtiles
*.pmtiles
*.MBTILES
*.mmdb
kmc_state_store.json

# ---- TLS material ----
nginx/ssl/*
!nginx/ssl/README.md

# ---- OS / editor noise ----
.DS_Store
Thumbs.db
*.log
